{
  "name": "boss-watch-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Approval-gated local job-search agent and DeepSeek Harness plugin.",
  "type": "module",
  "bin": {
    "boss-watch": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:extension",
    "build:core": "tsc -p tsconfig.build.json",
    "build:extension": "vite build --config extension/vite.config.ts",
    "check": "npm run typecheck && npm run lint",
    "demo": "npm run build:core && node dist/demo.js",
    "dsh:dev": "node scripts/start-dsh-local.mjs",
    "dsh:plugin:install": "corepack pnpm@11.7.0 --dir packages/dsh-plugin install",
    "dsh:plugin:test": "corepack pnpm@11.7.0 --dir packages/dsh-plugin test",
    "dsh:plugin:check": "corepack pnpm@11.7.0 --dir packages/dsh-plugin typecheck",
    "dsh:plugin:build": "corepack pnpm@11.7.0 --dir packages/dsh-plugin build",
    "export": "npm run build:core && node dist/cli.js export",
    "lint": "biome check src test extension/src/*.ts extension/src/*.css extension/vite.config.ts",
    "serve": "npm run build:core && node dist/cli.js serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p extension/tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@lucide/vue": "1.31.0",
    "html-to-text": "9.0.5",
    "postal-mime": "3.0.0",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@types/chrome": "0.2.6",
    "@types/html-to-text": "9.0.4",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.12.4",
    "@vitejs/plugin-vue": "6.0.8",
    "jsdom": "29.0.1",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.9",
    "vue-tsc": "3.3.9"
  }
}
